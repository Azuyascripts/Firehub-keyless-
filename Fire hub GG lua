-- 3. Role Checking Logic
local function getPlayerRole(player)
    local char = player.Character
    local backpack = player:FindFirstChild("Backpack")
    
    local function searchContainer(container)
        if not container then return nil end
        for _, item in pairs(container:GetChildren()) do
            if item:IsA("Tool") then
                local name = item.Name:lower()
                if name:find("knife") or name:find("blade") then
                    return "Murderer"
                elseif name:find("gun") or name:find("revolver") then
                    return "Sheriff"
                end
            end
        end
        return nil
    end

    local role = searchContainer(char) or searchContainer(backpack)
    if role == "Murderer" then return Color3.fromRGB(255, 0, 0), "Murderer" end
    if role == "Sheriff" then return Color3.fromRGB(0, 120, 255), "Sheriff" end
    return Color3.fromRGB(0, 255, 0), "Innocent"
end

-- 4. 8-Part Hitbox Box ESP Logic (Ghost-Proof & Transparent Wall-Thru)
local function applyBoxESPToPart(part, color, playerFolder)
    local boxName = part.Name .. "_BoxESP"
    local box = playerFolder:FindFirstChild(boxName)
    
    if not box then
        box = Instance.new("BoxHandleAdornment")
        box.Name = boxName
        box.AlwaysOnTop = true
        box.ZIndex = 8
        box.Transparency = 0.4
        box.Parent = playerFolder
    end
    
    box.Adornee = part
    box.Size = part.Size
    box.Color3 = color
end

local function isOwnedByPlayer(object)
    for _, player in pairs(Players:GetPlayers()) do
        if object:IsDescendantOf(player.Character) or object:IsDescendantOf(player.Backpack) then
            return true
        end
    end
    return false
end

local function updateESP()
    if not Settings.ESPEnabled then return end

    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer and not Settings.ShowSelfESP then
            local oldEsp = ESPFolder:FindFirstChild(player.Name)
            if oldEsp then oldEsp:Destroy() end
            continue
        end

        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
            local color, roleName = getPlayerRole(player)
            
            local playerFolder = ESPFolder:FindFirstChild(player.Name)
            if not playerFolder then
                playerFolder = Instance.new("Folder")
                playerFolder.Name = player.Name
                playerFolder.Parent = ESPFolder
            end

            -- Exactly 8 Primary Body Parts (Fallback for both R6 and R15 character rigs)
            local targetParts = {
                char:FindFirstChild("Head"),
                char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"),
                char:FindFirstChild("LowerTorso"),
                char:FindFirstChild("Left Arm") or char:FindFirstChild("LeftUpperArm"),
                char:FindFirstChild("Right Arm") or char:FindFirstChild("RightUpperArm"),
                char:FindFirstChild("Left Leg") or char:FindFirstChild("LeftUpperLeg"),
                char:FindFirstChild("Right Leg") or char:FindFirstChild("RightUpperLeg"),
                char:FindFirstChild("HumanoidRootPart")
            }

            for _, part in pairs(targetParts) do
                if part and part:IsA("BasePart") then
                    applyBoxESPToPart(part, color, playerFolder)
                end
            end

            local tag = playerFolder:FindFirstChild("NameTag")
            if not tag then
                tag = Instance.new("BillboardGui")
                tag.Name = "NameTag"
                tag.AlwaysOnTop = true
                tag.Size = UDim2.new(0, 100, 0, 30)
                tag.StudsOffset = Vector3.new(0, 3.5, 0)

                local label = Instance.new("TextLabel", tag)
                label.Name = "Label"
                label.Size = UDim2.new(1, 0, 1, 0)
                label.BackgroundTransparency = 1
                label.Font = Enum.Font.SourceSansBold
                label.TextSize = 13
                label.TextStrokeTransparency = 0
                label.Parent = tag

                tag.Parent = playerFolder
            end

            tag.Adornee = char.HumanoidRootPart
            local dist = math.floor((Camera.CFrame.Position - char.HumanoidRootPart.Position).Magnitude)
            tag.Label.Text = string.format("%s\n[%s] (%dm)", player.DisplayName, roleName, dist)
            tag.Label.TextColor3 = color
        else
            local oldEsp = ESPFolder:FindFirstChild(player.Name)
            if oldEsp then oldEsp:Destroy() end
        end
    end
end

-- Scan for Dropped Guns on Ground
local function scanGroundGuns()
    if not Settings.ESPEnabled then return end
    
    for _, obj in pairs(Workspace:GetDescendants()) do
        if (obj:IsA("Tool") or obj.Name == "GunDrop") and not isOwnedByPlayer(obj) then
            local hasParticles = false
            for _, desc in pairs(obj:GetChildren()) do
                if desc:IsA("ParticleEmitter") or desc:IsA("Sparkles") or desc:IsA("Highlight") then
                    hasParticles = true
                    break
                end
            end

            if hasParticles then
                local handle = obj:FindFirstChild("Handle") or obj:FindFirstChildOfClass("BasePart")
                if handle then
                    local gunTag = ESPFolder:FindFirstChild("DroppedGun_" .. obj:GetDebugId())
                    if not gunTag then
                        gunTag = Instance.new("BillboardGui")
                        gunTag.Name = "DroppedGun_" .. obj:GetDebugId()
                        gunTag.AlwaysOnTop = true
                        gunTag.Size = UDim2.new(0, 110, 0, 30)
                        gunTag.StudsOffset = Vector3.new(0, 2, 0)

                        local label = Instance.new("TextLabel", gunTag)
                        label.Size = UDim2.new(1, 0, 1, 0)
                        label.BackgroundTransparency = 1
                        label.Text = "DROPPED GUN 🗲"
                        label.TextColor3 = Color3.fromRGB(255, 255, 0)
                        label.Font = Enum.Font.SourceSansBold
                        label.TextSize = 13
                        label.TextStrokeTransparency = 0
                        label.Parent = gunTag

                        gunTag.Adornee = handle
                        gunTag.Parent = ESPFolder
                    end
                end
            end
        end
    end
end

-- 5. Functional Shoot Murderer Action
function shootMurdererAction()
    local murdererChar = nil
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local _, role = getPlayerRole(p)
            if role == "Murderer" and p.Character and p.Character:FindFirstChild("Head") then
                murdererChar = p.Character
                break
            end
        end
    end

    if not murdererChar then return end

    local gun = LocalPlayer.Character:FindFirstChildOfClass("Tool")
    if not (gun and (gun.Name:lower():find("gun") or gun.Name:lower():find("revolver"))) then
        gun = LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
        if gun and (gun.Name:lower():find("gun") or gun.Name:lower():find("revolver")) then
            gun.Parent = LocalPlayer.Character
        end
    end

    if gun then
        local targetPos = murdererChar.Head.Position
        local remote = gun:FindFirstChildOfClass("RemoteEvent") or gun:FindFirstChildOfClass("RemoteFunction")
        if remote then
            if remote:IsA("RemoteEvent") then
                remote:FireServer(targetPos, murdererChar.Head)
            elseif remote:IsA("RemoteFunction") then
                remote:InvokeServer(targetPos, murdererChar.Head)
            end
        else
            gun:Activate()
        end
    end
end

